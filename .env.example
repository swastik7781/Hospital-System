# Environment
ENVIRONMENT=development
DEBUG=True

# Database (Use postgresql+asyncpg for PostgreSQL, or sqlite+aiosqlite for local development)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hospital_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT Secret & Expirations
SECRET_KEY=hospital-super-secure-production-secret-key-change-in-prod-1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_STANDARD=120/minute

# Storage
UPLOAD_DIR=uploads
